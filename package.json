{
  "name": "pyxis-gtm-template",
  "version": "0.0.0",
  "private": true,
  "description": "Google Tag Manager community template that installs the Pyxis tracker without code.",
  "homepage": "https://github.com/samuelcsantana/pyxis-gtm-template#readme",
  "bugs": {
    "url": "https://github.com/samuelcsantana/pyxis-gtm-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelcsantana/pyxis-gtm-template.git"
  },
  "license": "Apache-2.0",
  "author": "Samuel Santana",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && node scripts/check-no-comments.mts",
    "test:tooling": "node --test \"eslint-rules/**/*.test.mjs\" \"scripts/**/*.test.mts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "node scripts/build-template.mts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "src/**/*.ts": "vitest related --run",
    "*.{json,yml,yaml,md}": "prettier --check"
  }
}
